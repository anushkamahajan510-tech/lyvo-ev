{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/products/lyvo-passenger", "destination": "/products/lyvo-passenger.html" },
    { "source": "/products/lyvo-loader", "destination": "/products/lyvo-loader.html" },
    { "source": "/products/lyvo-garbage", "destination": "/products/lyvo-garbage.html" },
    { "source": "/products/livo-passenger", "destination": "/products/livo-passenger.html" },
    { "source": "/products/livo-loader", "destination": "/products/livo-loader.html" },
    { "source": "/products/livo-garbage", "destination": "/products/livo-garbage.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/why-lyvo", "destination": "/why-lyvo.html" },
    { "source": "/why-livo", "destination": "/why-lyvo.html" },
    { "source": "/vision-mission", "destination": "/vision-mission.html" },
    { "source": "/become-a-dealer", "destination": "/become-a-dealer.html" },
    { "source": "/become-dealer", "destination": "/become-a-dealer.html" },
    { "source": "/dealers/become-dealer", "destination": "/become-a-dealer.html" },
    { "source": "/dealers", "destination": "/dealers.html" },
    { "source": "/find-dealer", "destination": "/dealers.html" },
    { "source": "/find-a-dealer", "destination": "/dealers.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/quotation", "destination": "/quotation.html" },
    { "source": "/privacy", "destination": "/privacy-policy.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms-and-conditions", "destination": "/terms.html" }
  ]
}
